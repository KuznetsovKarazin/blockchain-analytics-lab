  "findings": [
    {
      "id": "DF01",
      "severity": "resolved",
      "finding": "Review initially demonstrated that a valid step8 plan could replace a model installed with a step9 plan. The narrow guard now requires strictly increasing declared activation steps; valid stale and same-step candidates retain the old pair.",
      "observed_stale_plan_installed": false,
      "remaining_boundary": "An optional initial_activation_step declares initial timing; when absent the first successful candidate establishes chronology. This checks declared ordering, not actual fitting, queue phase, wall-clock timing or estimator provenance. The reviewer implemented this narrow correction and reran the independent specification checks."
    },
    {
      "id": "DF02",
      "severity": "declared_limit",
      "finding": "Available labels in initial_history are a separate warm-start assumption, including recent history regardless of online delay. This is explicitly documented; future experiments must declare which development/validation labels are already available."
    },
    {
      "id": "DF03",
      "severity": "definition",
      "finding": "Calibration uses the latest four source steps with at least one known label; unknown-only steps do not count. This can extend the age span. Specify this exact choice and do not silently describe it as four consecutive stream steps."
    },
    {
      "id": "DF04",
      "severity": "declared_limit",
      "finding": "Only the prediction-facing view omits future labels. Python queue internals store preloaded future labels; the API is not a security sandbox."
    },
    {
      "id": "DF05",
      "severity": "declared_limit",
      "finding": "end_step attests that predictions were recorded; it does not verify a persisted decision journal. Integration must commit predictions before invoking release."
    },
    {
      "id": "DF06",
      "severity": "declared_limit",
      "finding": "Registry checks version labels, cohort/timing/class constraints and whole-pair fallback; it cannot verify that actual estimator fitting excludes calibration rows or that supplied scores were produced by that estimator. No threshold-selection algorithm, estimator artifact, persistent update journal or real Elliptic execution is implemented by this utility."
    }
  ]
